# ─── Variables para docker-compose RAÍZ ───────────────────────────────────
# Copia este archivo como .env y rellena los valores REALES
# NUNCA commitees .env con valores reales — siempre usa variables de entorno

# ─── Base de Datos ─────────────────────────────────────────────────────────
# Genera una contraseña fuerte: `openssl rand -base64 32`
DB_ROOT_PASSWORD=CAMBIA_ESTO_A_CONTRASEÑA_FUERTE
DB_NAME=midnightcode

# ─── Frontend ──────────────────────────────────────────────────────────────
# URL de la API que verá el frontend
# Desarrollo: http://localhost:3000/api
# Producción: https://api.tu-dominio.com/api
VITE_API_URL=http://localhost:3000/api
